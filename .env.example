# Environment Configuration Template (.env.example)
# Copy this file to '.env' in the project root for local development.

# OpenAI API Key used for server-side LLM request processing.
OPENAI_API_KEY=<your-openai-api-key>

# OpenAI model identifier for analysis requests.
# Defaults to 'gpt-4o-mini' if not specified.
OPENAI_MODEL=gpt-4o-mini

# Server-side API key for request authentication header validation.
API_KEY=your_shared_api_key_here

# Client-side frontend API key passed in x-api-key headers.
VITE_API_KEY=your_shared_api_key_here

# Upstash Redis REST URL for distributed rate limiting (10 req/min).
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io

# Upstash Redis REST Token for distributed rate limiting.
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# [OPTIONAL] Skip rate limiting checks during local development (true/false).
SKIP_RATE_LIMIT=false
