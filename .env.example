# API key for server-side validation 
API_KEY=your_shared_api_key_here

# API key for client-side frontend
VITE_API_KEY=your_shared_api_key_here

# OpenAI API key for server-side LLM requests
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Upstash Redis REST credentials for IP-based rate limiting (10 req/min)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Optional: Skip rate limiting in local development environment (true/false)
SKIP_RATE_LIMIT=false
